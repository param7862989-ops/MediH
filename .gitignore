# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv/

# Environment Variables & Secrets
.env
!.env.example

# Databases
database/*.db
database/*.sqlite3
*.db
*.sqlite3

# Large Dataset Files (keep placeholders)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Machine Learning Serialized Weights (large binary files)
models_store/*
!models_store/.gitkeep

# Application & Audit Logs
logs/*
!logs/.gitkeep

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
