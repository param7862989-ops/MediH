# ==============================================================================
# MediHaven Environment Configuration Template
# Copy this file to .env and customize values for your local environment
# ==============================================================================

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Configuration
DATABASE_PATH=database/medihaven.db

# Cryptographic QR & Vault Token Security
# Secret used to sign and verify QR JSON Web Tokens (HMAC-SHA256)
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-key
JWT_ALGORITHM=HS256
DEFAULT_TOKEN_TTL_MINUTES=1440

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/medihaven.log
AUDIT_LOG_FILE=logs/vault_access_audit.log

# Machine Learning & Clinical Thresholds
KNN_NEIGHBORS=5
KMEANS_CLUSTERS=4
DECISION_TREE_MAX_DEPTH=5
HIGH_RISK_THRESHOLD=0.70
CRITICAL_RISK_THRESHOLD=0.85
EARLY_WARNING_WINDOW_DAYS_MIN=7
EARLY_WARNING_WINDOW_DAYS_MAX=14

# Optional: External LLM Integration (for future natural language explanations)
# GEMINI_API_KEY=your_gemini_api_key_here
