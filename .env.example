# ==============================================================================
# MediHaven Environment Configuration Template
# Copy this file to .env and customize values for your local environment
# ==============================================================================

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Configuration
DATABASE_PATH=database/medihaven.db

# Optional overrides for model artifacts and processed synthetic features (defaults shown)
# MODELS_STORE_DIR=models_store
# PROCESSED_DATA_DIR=data/processed

# Data mode: "synthetic" (default, seeded demo) or "mimic" (research mode, explicit opt-in).
# Research mode never seeds/trains synthetic assets, disables synthetic clinical predictions and
# serves a research-only view over verified Phase 2 artifacts. It refuses to start with the default
# secrets above, a non-loopback FLASK_HOST or the debugger. See docs/research/phase3_integration_security.md
DATA_MODE=synthetic

# Web security (defaults shown). CORS_ORIGINS: comma-separated allowlist; empty = same-origin only.
# CORS_ORIGINS=
# SESSION_COOKIE_SECURE=0   # set to 1 when served over HTTPS
# MAX_REQUEST_MB=8
# Optional SHA-256 of the Phase 2 run_manifest.json that research mode must load (authenticity pin)
# RESEARCH_ARTIFACT_MANIFEST_SHA256=

# MIMIC-IV research data (only for: python -m src.tasks.build_mimic_t1).
# Both folders must be OUTSIDE this repository and OUTSIDE OneDrive.
# MIMIC_IV_DIR=C:\research\mimic-iv-clinical-database-demo-2.2
# MIMIC_OUTPUT_DIR=C:\research\medihaven-output

# Cryptographic QR & Vault Token Security
# Secret used to sign and verify QR JSON Web Tokens (HMAC-SHA256)
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-key
JWT_ALGORITHM=HS256
DEFAULT_TOKEN_TTL_MINUTES=1440

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/medihaven.log
AUDIT_LOG_FILE=logs/vault_access_audit.log

# Machine Learning & Clinical Thresholds
KNN_NEIGHBORS=5
KMEANS_CLUSTERS=4
DECISION_TREE_MAX_DEPTH=5
HIGH_RISK_THRESHOLD=0.70
CRITICAL_RISK_THRESHOLD=0.85
EARLY_WARNING_WINDOW_DAYS_MIN=7
EARLY_WARNING_WINDOW_DAYS_MAX=14

# Optional: External LLM Integration (for future natural language explanations)
# GEMINI_API_KEY=your_gemini_api_key_here
